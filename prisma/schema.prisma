generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Admin Authentication & User Management
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Products Catalog & Specifications
model Product {
  id             String   @id
  slug           String
  code           String   @unique
  title          String
  category       String   // Water Treatment, HVAC & Climate, Fire Protection, Power & Switchgear
  brand          String?  @default("Elite Standard Limited")
  sector         String[] // Residential, Commercial, Industrial
  price          Float
  priceFormatted String
  regularPrice   String?
  inStock        Boolean  @default(true)
  stockBadge     String?  // In Stock, UL/FM Approved, Custom Built, etc.
  warranty       String?  @default("2 Years OEM Service Warranty")
  image          String
  galleryImages  String[] @default([]) // Multi images array
  variantsText   String?
  description    String?  @db.Text
  specs          Json     // Array of { label: string, value: string }
  fullSpecs      Json?    // Array of { attribute: string, value: string }
  href           String?
  iconName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

// 3. Projects & Landmark Case Studies
model Project {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  category       String
  client         String
  location       String
  completionDate String
  description    String   @db.Text
  image          String
  gallery        Json?    // Array of { title: string, image: string, category: string }
  scope          String[] // Array of bullet points
  isFeatured     Boolean  @default(false) // Highlighted featured landmark project
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isFeatured])
}

// 4. Inquiries, RFQ & Customer Leads
model Inquiry {
  id          String   @id @default(uuid())
  type        String   @default("quotation") // quotation, consultation, contact, product
  productName String?
  name        String
  phone       String
  email       String?
  facility    String?
  message     String?  @db.Text
  status      String   @default("PENDING") // PENDING, CONTACTED, QUOTED, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 5. Corporate Client References & Brand Partners
model ClientReference {
  id         String   @id @default(uuid())
  name       String
  type       String   // e.g. Banking & Infrastructure, HVAC Chillers & VRF
  category   String   @default("client") // "client" or "partner"
  monogram   String?
  logo       String?
  bgColor    String?  @default("bg-blue-50 text-blue-600 border-blue-100")
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// 6. Technical Blogs & Case Studies
model Blog {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  category    String
  author      String
  publishedAt String
  readTime    String?
  summary     String   @db.Text
  content     String   @db.Text
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 7. MEP Services & Solutions (Dynamic Admin CRUD)
model Service {
  id               String   @id @default(uuid())
  slug             String   @unique
  code             String   @unique // e.g. ESL-MEP-HVAC
  category         String   // mechanical, electrical, plumbing
  title            String
  subtitle         String?
  shortDescription String   @db.Text
  fullDescription  String   @db.Text
  icon             String   @default("FaIndustry")
  bannerImage      String
  compliance       String[] // ["BNBC", "ASHRAE", "SMACNA", "NFPA"]
  problems         String[] // Array of challenges/pain points
  solutions        String[] // Array of engineering solutions
  scopeOfWork      String[] // Array of scope of work steps
  subServices      Json?    // Array of SubServiceDetail objects
  faqs             Json?    // Array of { question, answer }
  sectors          Json?    // { residential, commercial, industrial }
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

// 8. Careers & Recruitment (Job Vacancies & Open Positions)
model JobPosition {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  department       String           // Mechanical, Electrical, Fire Protection, Automation, etc.
  location         String           @default("Amtola / Banani, Dhaka")
  type             String           @default("Full Time") // Full Time, Part Time, Contractual, Internship
  experience       String           // e.g. "3 - 5 Years"
  salary           String           // e.g. "BDT 60,000 - 90,000 / Month (Negotiable)"
  salaryBadge      String?          // e.g. "BDT 60k - 90k"
  summary          String           @db.Text
  qualifications   String[]         // List of qualification bullet points
  responsibilities String[]         // List of job responsibility bullet points
  isActive         Boolean          @default(true)
  deadline         String?
  orderIndex       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  applications     JobApplication[]

  @@index([department])
  @@index([isActive])
}

// 9. Job Candidate Applications
model JobApplication {
  id            String       @id @default(uuid())
  jobPositionId String?
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  positionTitle String
  fullName      String
  email         String
  phone         String
  experience    String?
  resumeUrl     String?      // Uploaded CV link or file
  coverNote     String?      @db.Text
  status        String       @default("NEW") // NEW, REVIEWED, SHORTLISTED, REJECTED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([jobPositionId])
  @@index([status])
}

// 10. Newsletter & Email Subscribers
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  interest  String   @default("all") // all, hvac, water, fire, power
  source    String   @default("website") // footer, newsletter_page
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([interest])
  @@index([createdAt])
}

// 11. Engineering Bulletins & Technical Whitepapers
model EngineeringBulletin {
  id          String   @id @default(uuid())
  issue       String   // e.g. "Bulletin #24 — Q3 Edition"
  title       String   // e.g. "Tropical VRF Air Conditioning: Optimizing COP..."
  category    String   // HVAC & Thermal Dynamics, Life Safety & Protection, Water Treatment (WTS), Electrical & Switchgear
  date        String   // e.g. "October 2026"
  readTime    String?  // e.g. "6 min read"
  summary     String   @db.Text
  highlights  String[] // Key Engineering Insights bullet points
  pdfUrl      String?  // Direct PDF download or brochure URL
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// 12. Key Engineering Sectors & Industries (Dynamic Admin CRUD)
model IndustrySector {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String   @default("FaBuilding") // FaBuilding, FaFlaskVial, FaIndustry, FaHospital, FaServer, FaSun, etc.
  image       String
  href        String?  @default("/sectors")
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([orderIndex])
}


